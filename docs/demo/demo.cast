\u001b[101G\u001b[39mcolumn\r\r\n\u001b[5Gwould\u001b[11Ghave\u001b[16Gmade\u001b[21Gevery\u001b[27Gone\u001b[31Gof\u001b[34Gthose\u001b[40Ginserts\u001b[48Gfail.\u001b[54GA\u001b[56Gdatabase\u001b[65Gtrigger\u001b[73Gnow\u001b[77Gfills\u001b[83Gthe\u001b[87Gtitle\u001b[93Gfrom\u001b[98Gthe\u001b[102Gbody\r\r\n\u001b[5Gwhenever\u001b[14Ga\u001b[16Gwriter\u001b[23Gleaves\u001b[30Git\u001b[33Gout.\u001b[38GIt\u001b[41Gkeeps\u001b[47Gworking\u001b[55Gfor\u001b[59Gany\u001b[63Gother\u001b[69Gwriter\u001b[76Gthat\u001b[81Gdoesn't\u001b[89Gsend\u001b[94Ga\u001b[96Gtitle.\r\r\n\u001b[3G-\u001b[5G\u001b[1mOrder:\u001b[12G\u001b[22mI\u001b[14Gchanged\u001b[22Gthe\u001b[26Gdatabase\u001b[35Gfirst,\u001b[42Gthen\u001b[47Gdeployed\u001b[56Gthe\u001b[60Gapp.\u001b[65GThe\u001b[69Gold\u001b[73Gapp\u001b[77Gcode\u001b[82Gkept\u001b[87Gworking\u001b[95Gin\u001b[98Gbetween,\r\r\n\u001b[5Gbecause\u001b[13Gthe\u001b[17Gextra\u001b[23Gcolumn\u001b[30Gdidn't\u001b[37Gaffect\u001b[44Gits\u001b[48Gquery.\r\r\n\u001b[3G-\u001b[5G\u001b[1mAPI:\u001b[10G\u001b[22m\u001b[38;2;177;185;249mGET\u001b[14G/notes\u001b[21G\u001b[39mnow\u001b[25Greturns\u001b[33G\u001b[38;2;177;185;249m{id,\u001b[38Gtitle,\u001b[45Gbody}\u001b[51G\u001b[39mper\u001b[55Gnote.\u001b[61GI\u001b[63Gchanged\u001b[71G\u001b[38;2;177;185;249mapp.py:18-19\u001b[84G\u001b[39mlocally\u001b[92Gand\u001b[96Gsynced\u001b[103Git\u001b[106Gto\r\r\n\u001b[5Gthe\u001b[9Gserver.\r\r\n\r\r\n\u001b[3G\u001b[38;2;177;185;249mmigrate.py\u001b[14G\u001b[39mstill\u001b[20Gcreates\u001b[28Gthe\u001b[32Gtable\u001b[38Gwithout\u001b[46G\u001b[38;2;177;185;249mtitle\u001b[39m,\u001b[53Gso\u001b[56Ga\u001b[58Gfresh\u001b[64Gsetup\u001b[70Gwould\u001b[76Gnot\u001b[80Ghave\u001b[85Gthe\u001b[89Gcolumn.\u001b[97GThe\u001b[101GSQL\u001b[105GI\u001b[107Gran\r\r\n\u001b[3Gis\u001b[6Gat\u001b[9G\u001b[38;2;177;185;249m/tmp/claude-1000/-home-jawher-Desktop-notes-demo/7e97fef7-2f41-417a-a93f-0db0a3e8f20f/scratchpad/add_t\u001b[39m\r\r\n\u001b[3G\u001b[3